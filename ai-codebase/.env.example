# ─────────────────────────────────────────────────────────────────────────────
# .env.example — VetPay Automated Outbound Call Agent
# Copy this file to .env and fill in real values before running the app.
# NEVER commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ╔══════════════════════════════════════════════════════════════════╗
# ║  TWILIO — Outbound Calling & Webhooks                           ║
# ╚══════════════════════════════════════════════════════════════════╝

# Required | Your Twilio Account SID (starts with AC...)
# Found at: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required | Your Twilio Auth Token
# Found at: https://console.twilio.com → Account Info
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Required | The Twilio phone number used to make outbound calls
# Format: E.164 international format (e.g. +61400000000 for AU)
# Used by: main.py → twilio.calls.create(from_=...)
TWILIO_PHONE_NUMBER=+61400000000


# ╔══════════════════════════════════════════════════════════════════╗
# ║  ELEVENLABS — Text-to-Speech                                    ║
# ╚══════════════════════════════════════════════════════════════════╝

# Required | Your ElevenLabs API key
# Found at: https://elevenlabs.io → Profile → API Key
# Used by: main.py → generate_audio()
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional | The ElevenLabs Voice ID to use for TTS
# Default: snyKKuaGYk1VUEh42zbW (pre-configured voice)
# To find IDs: https://api.elevenlabs.io/v1/voices (with your key)
# Used by: main.py → generate_audio()
ELEVENLABS_VOICE_ID=snyKKuaGYk1VUEh42zbW


# ╔══════════════════════════════════════════════════════════════════╗
# ║  APPLICATION — Network & Routing                                ║
# ╚══════════════════════════════════════════════════════════════════╝

# Required | Publicly accessible HTTPS base URL of this application
# Twilio webhooks call back to this URL — it MUST be HTTPS and reachable
# by Twilio's servers (i.e. not localhost).
# For local dev: use ngrok → ngrok http 8000 → copy the https URL
# For production: set to your domain, e.g. https://calls.vetpay.com.au
# Used by: main.py → twilio.calls.create(url=...) and TwiML <Play> tags
BASE_URL=https://your-public-url.ngrok-free.app


# ╔══════════════════════════════════════════════════════════════════╗
# ║  CALL BEHAVIOUR — Agent & Messaging                             ║
# ╚══════════════════════════════════════════════════════════════════╝

# Required | Phone number of the human agent to transfer interested callers to
# Format: E.164 international format (e.g. +61400000001)
# Used by: main.py → vr.dial(HUMAN_AGENT_NUMBER)
HUMAN_AGENT_NUMBER=+61400000001

# Required | The full script text that is converted to MP3 and played to every caller
# Keep this as a single-line string. Escape internal quotes if needed.
# Used by: main.py → generate_audio(COMMON_TEXT, COMMON_MESSAGE_PATH)
COMMON_MESSAGE_TEXT="This is an automated call from VetPay. It looks like we may have the wrong payment details for you. If you'd like to update them and speak to our team now, say transfer me or press 1. Alternatively you can update your details on your portal at vetpay.com.au. We hope we have been able to assist with your pets treatment. Thank you. Would you like to transfer?"


# ╔══════════════════════════════════════════════════════════════════╗
# ║  SECURITY — JWT Authentication                                  ║
# ╚══════════════════════════════════════════════════════════════════╝

# Required | Random secret key used to sign JWT tokens
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the default in production.
# Used by: main.py → jwt.encode() / jwt.decode()
JWT_SECRET_KEY=change_this_to_a_long_random_string_before_deploying


# ╔══════════════════════════════════════════════════════════════════╗
# ║  OPTIONAL — OpenAI (currently unused in codebase)              ║
# ╚══════════════════════════════════════════════════════════════════╝

# Optional | OpenAI API key (loaded in config.py but not yet used in main.py)
# OPENAI_API_KEY=sk-...
